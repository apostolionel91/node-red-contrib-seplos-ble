{
  "name": "node-red-contrib-seplos-ble",
  "version": "1.3.0",
  "description": "Node-RED reader for Seplos V3 BMS over Bluetooth (BlueZ D-Bus, read-only, every pack). Adapted from node-red-contrib-sok.",
  "scripts": {
    "test": "node test/run.mjs && node examples/battery-page/fn-test.mjs && node examples/gx-health/test.mjs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "nodes",
    "README.md",
    "LICENSE"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "seplos-battery-device": "nodes/seplos-battery-device.js",
      "seplos-battery-get": "nodes/seplos-battery-get.js"
    }
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "node-red",
    "seplos",
    "bms",
    "battery",
    "bluetooth",
    "ble",
    "modbus",
    "victron",
    "venus-os"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apostolionel91/node-red-contrib-seplos-ble.git"
  },
  "homepage": "https://github.com/apostolionel91/node-red-contrib-seplos-ble#readme",
  "bugs": {
    "url": "https://github.com/apostolionel91/node-red-contrib-seplos-ble/issues"
  }
}
